# After pulling env, apply SQL migrations in db/migrations/ (including 003_global_templates.sql).

# Neon Postgres connection string (required for /admin, /[slug], and org-aware home page).
# Example: postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Public site origin for share links and signature image URLs (no trailing slash).
# Required in production so Gmail/Outlook can load logos (not localhost).
# Example: https://signatures.c4photosafaris.com
NEXT_PUBLIC_APP_URL=

# Optional default logo in exported signatures (HTTPS, publicly reachable).
# NEXT_PUBLIC_SIGNATURE_LOGO_URL=https://www.c4photosafaris.com/path/to/logo.png

# Cloudflare R2 — logo uploads in Admin → Organization (S3-compatible API).
# CLOUDFLARE_R2_ACCOUNT_ID=
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_BUCKET_NAME=
# CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# Admin dashboard auth (required in production). Sign in at /admin/login.
# ADMIN_SECRET=your-strong-password
# Role for password login: admin | editor | viewer (default: admin)
# ADMIN_ROLE=admin
