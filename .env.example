# Neon Postgres connection string (required for /admin, /[slug], and org-aware home page).
# Example: postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Public site origin for share links (no trailing slash). Recommended in production.
# Example: https://signatures.example.com
NEXT_PUBLIC_APP_URL=

# Optional override for logo in generated HTML (takes precedence over org settings logo URL).
# NEXT_PUBLIC_SIGNATURE_LOGO_URL=
